# Affiliation Configuration
# COMPLETE HTTPS links copied from the approved partner dashboard.
# Legacy IDs below are not sufficient to activate a commission link.
TRAVELPAYOUTS_FLIGHT_URL=
DIRECT_FERRIES_AFFILIATE_URL=
TRAVELPAYOUTS_PARTNER_ID=your_travelpayouts_id
DIRECT_FERRIES_PARTNER_ID=your_directferries_id
DIRECT_FERRIES_BASE_URL=your_directferries_base_url

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Canonical app URL, added to the CORS allow-list for API routes
# (app/api/affiliates, app/api/prayer) in middleware.ts. Optional: the
# middleware already whitelists the known production domains by default.
NEXT_PUBLIC_APP_URL=https://rme-voyage.com

# Supabase (future use)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# App download destination (HTTPS App Store, Google Play or landing URL)
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://your-download-url.example
