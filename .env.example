# ────────────────────────────────────────────────────────────────────
# RME Voyage Environment Variables
# ────────────────────────────────────────────────────────────────────
# Add these to Vercel → Project Settings → Environment Variables (Production)

# ── AI/LLM (Hadak) ────────────────────────────────────────────────
# Hadak tries these in order: Groq → OpenAI → Anthropic
# If one fails, it falls back to the next

# Groq (FREE, gratuit, gsk_* prefix)
# Get it: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Anthropic Claude (FREE tier, $5 credits, sk-ant-* prefix)
# Get it: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (optional, paid, sk-proj-* or sk-* prefix)
# Get it: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-...

# ── Monitoring & Analytics ────────────────────────────────────────
# Sentry (error tracking, free tier)
# Get it: https://sentry.io/signup/ → Create project → Client Keys
SENTRY_DSN=https://...@sentry.io/...

# PostHog (analytics, free tier)
# Get it: https://posthog.com/signup → Settings → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ── Notifications (optional) ──────────────────────────────────────
# Slack webhook (send errors to Slack)
# Get it: https://api.slack.com/messaging/webhooks → Create New App
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Contact Email ─────────────────────────────────────────────────
# For /pro, /boutique, etc.
NEXT_PUBLIC_CONTACT_EMAIL=your-email@rme-voyage.com
