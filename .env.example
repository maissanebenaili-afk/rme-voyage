# Affiliation Configuration
# COMPLETE HTTPS links copied from the approved partner dashboard.
# Legacy IDs below are not sufficient to activate a commission link.
TRAVELPAYOUTS_FLIGHT_URL=
DIRECT_FERRIES_AFFILIATE_URL=
TRAVELPAYOUTS_PARTNER_ID=your_travelpayouts_id
DIRECT_FERRIES_PARTNER_ID=your_directferries_id
DIRECT_FERRIES_BASE_URL=your_directferries_base_url

# API Configuration
# When true, Hadak blocks paid LLM providers and uses only providers
# explicitly marked free in its server-side registry.
AI_ROUTER_FREE_ONLY=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Canonical app URL, added to the CORS allow-list for API routes
# (app/api/affiliates, app/api/prayer) in proxy.ts. Optional: the
# proxy already whitelists the known production domains by default.
NEXT_PUBLIC_APP_URL=https://rme-voyage.com

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Stripe — powers /soutenir (free-amount donation checkout).
# Secret key only; no publishable key needed (server creates the Checkout
# Session, the browser is just redirected to its URL). Without this set,
# /api/support/checkout returns 503 and the donation page shows a clear
# "not yet available" message instead of crashing.
# STRIPE_SECRET_KEY=sk_live_...

# External APIs
# Prayer times (Aladhan - free, no key required)
# ALADHAN_API_KEY=optional

# Weather (OpenWeatherMap)
# OPENWEATHERMAP_API_KEY=your_api_key

# AI providers (server-side only; never expose keys to the browser)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Exchange rates (exchangerate-api - free tier available)
# EXCHANGE_RATE_API_KEY=optional

# App download destination (HTTPS App Store, Google Play or landing URL)
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://your-download-url.example
